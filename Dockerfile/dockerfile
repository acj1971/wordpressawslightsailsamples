# Use the official WordPress image as the base
FROM wordpress:latest

# Update packages and install additional dependencies as needed
RUN apt-get update && apt-get install -y \
    curl \
    less \
    nano \
    unzip \
    zip \
 && rm -rf /var/lib/apt/lists/*

# Install WP-CLI for managing WordPress via the command line
RUN curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && \
    chmod +x wp-cli.phar && \
    mv wp-cli.phar /usr/local/bin/wp

# (Optional) Install PHP extensions if required
# Example: mysqli
RUN docker-php-ext-install mysqli && docker-php-ext-enable mysqli

# (Optional) Copy local WordPress content, plugins, or themes into the container
# COPY ./wp-content /var/www/html/wp-content

# Set environment variables if you want to override default WordPress settings
# (These are often set via docker-compose or container orchestration platforms)
# ENV WORDPRESS_DB_HOST=db
# ENV WORDPRESS_DB_USER=wordpress
# ENV WORDPRESS_DB_PASSWORD=secret
# ENV WORDPRESS_DB_NAME=wordpress

# Expose the default HTTP port
EXPOSE 80

# Set the default command to run when the container starts
CMD ["apache2-foreground"]
